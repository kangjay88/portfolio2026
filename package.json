{
  "name": "portfolio-site",
  "version": "2.0.0",
  "description": "Portfolio — Node.js, Express, EJS, Tailwind, GSAP, Lenis",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "css:watch": "npx @tailwindcss/cli -i ./src/input.css -o ./public/css/output.css --watch",
    "css:build": "npx @tailwindcss/cli -i ./src/input.css -o ./public/css/output.css --minify",
    "build": "npm run css:build"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "ejs": "^3.1.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "tailwindcss": "^4.0.0",
    "@tailwindcss/cli": "^4.0.0"
  }
}
