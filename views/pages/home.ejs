<%- include('../partials/head') %>
<%- include('../partials/preloader') %>
<%- include('../partials/header') %>
<%- include('../partials/nav-overlay') %>

<main>
  <!-- ═══ HERO ═══ -->
  <section data-hero class="min-h-[68vh] flex flex-col justify-center px-6 md:px-12 lg:px-20 pt-20 pb-8 relative overflow-hidden">
    <div data-hero-divider class="absolute top-[45%] left-0 right-0 h-px bg-base-800"></div>

    <div class="relative z-10 flex flex-col md:flex-row md:items-end md:justify-between gap-10 md:gap-12">

      <!-- NAME -->
      <div class="md:flex-1" data-parallax-hero>
        <% const nameParts = site.name.split(' '); %>
        <h1 data-hero-line data-shuffle-load="single" class="hero-title"><%= nameParts[0] || 'Jay' %></h1>
        <h1 data-hero-line data-shuffle-load="single" class="hero-title"><%= nameParts.slice(1).join(' ') || 'Kang' %></h1>
       
      </div>

      <!-- DESIGNER & DEVELOPER -->
      <div class="flex flex-col gap-1 min-w-[120px]">
        <p data-hero-subtitle class="font-mono text-xs uppercase tracking-widest text-base-300" data-shuffle-load="single" data-shuffle-lock>Designer &amp;</p>
        <p data-hero-subtitle class="font-mono text-xs uppercase tracking-widest text-base-300" data-shuffle-load="single" data-shuffle-lock>Developer</p>
      </div>

      <!-- LOCATION / CONTACT / CLOCK -->
      <div class="flex flex-col gap-1 min-w-[120px]" data-hero-meta>
        <p class="font-mono text-xs uppercase tracking-widest text-base-300" data-shuffle-load="single" data-shuffle-lock><%= site.location %></p>
        <div data-hero-cta>
          <a href="mailto:<%= site.email %>" data-magnetic data-shuffle="button"
             class="inline-flex items-center gap-1 font-mono text-xs uppercase tracking-widest text-base-200 hover:text-base-50 transition-colors duration-300">
            <span class="text-bracket">[</span>
            <span data-shuffle="text" data-shuffle-hover="Email me">Contact</span>
            <span class="text-bracket">]</span>
          </a>
        </div>
        <p class="font-mono text-xs text-base-400 tracking-wider tabular-nums" id="liveClock">00:00:00</p>
      </div>

    </div>
  </section>

  <!-- ═══ FEATURED PROJECTS ═══ -->
  <section class="py-16 md:py-24">
    <div class="px-6 md:px-12 lg:px-20 mb-8 flex items-end justify-between" data-scroll="fade-up">
      <div>
        <span class="font-mono text-xs tracking-widest uppercase block mb-2">
          <span class="text-bracket">[</span>
          <span class="text-base-400" data-shuffle-load="single" data-shuffle-lock>Featured Projects</span>
          <span class="text-bracket">]</span>
        </span>
        <h2 class="font-display text-2xl md:text-3xl font-bold text-base-50 tracking-tight">Selected Work</h2>
      </div>
      <span class="font-mono text-xs text-base-400 hidden md:block">(Scroll →)</span>
    </div>

    <div class="mx-6 md:mx-12 lg:mx-20 h-px bg-base-800 mb-8" data-scroll="line"></div>

    <div class="carousel" id="projectCarousel">
      <% featured.forEach((project, i) => { %>
        <%- include('../partials/project-card', { project, index: i }) %>
      <% }) %>
    </div>

    <div class="px-6 md:px-12 lg:px-20 mt-4 flex items-center gap-3" data-scroll="fade-up">
      <span class="font-mono text-xs text-base-400">
        <span id="currentSlide">1</span> / <%= featured.length %>
      </span>
      <span class="font-mono text-xs text-base-400 uppercase tracking-widest" data-shuffle-load="single" data-shuffle-lock>featured work</span>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/end') %>
