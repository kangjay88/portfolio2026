<%- include('../partials/head') %>
<%- include('../partials/preloader') %>
<%- include('../partials/header') %>
<%- include('../partials/nav-overlay') %>

<main class="min-h-screen flex flex-col">
  <!-- ═══ HERO ═══ -->
  <section data-hero class="flex-1 flex flex-col justify-center px-6 md:px-12 lg:px-20 pt-20 pb-8 relative overflow-hidden">
    <div data-hero-divider class="absolute top-[45%] left-0 right-0 h-px bg-base-800"></div>

    <div class="relative z-10 flex flex-col md:flex-row md:items-end md:justify-between gap-10 md:gap-12">

      <!-- NAME -->
      <div class="md:flex-1" data-parallax-hero>
        <% const nameParts = site.name.split(' '); %>
        <h1 data-hero-line data-hero-name="1" data-shuffle-load="single" class="hero-title"><%= nameParts[0] || 'Jay' %></h1>
        <h1 data-hero-line data-hero-name="2" data-shuffle-load="single" class="hero-title"><%= nameParts.slice(1).join(' ') || 'Kang' %></h1>

      </div>

      <!-- META + ACTIONS -->
      <div class="flex flex-col gap-6 md:items-end">

        <!-- IDENTITY + LOCATION (ambient meta) -->
        <div class="flex gap-8 md:gap-10">
          <div class="flex flex-col gap-1 min-w-[110px]">
            <p data-hero-subtitle data-hero-role="1" class="font-mono text-xs uppercase tracking-widest text-base-300" data-shuffle-load="single">Designer &amp;</p>
            <p data-hero-subtitle data-hero-role="2" class="font-mono text-xs uppercase tracking-widest text-base-300" data-shuffle-load="single">Developer</p>
          </div>
          <div class="flex flex-col gap-1 min-w-[110px]" data-hero-meta>
            <p data-hero-location class="font-mono text-xs uppercase tracking-widest text-base-300" data-shuffle-load="single"><%= site.location %></p>
            <p class="font-mono text-xs text-base-400 tracking-wider tabular-nums" id="liveClock">00:00:00</p>
          </div>
        </div>

        <!-- ACTIONS (elevated CTAs) -->
        <div class="flex flex-col gap-3.5 md:items-end" data-hero-meta data-hero-connect>
          <div class="flex items-center gap-5">
            <a href="mailto:<%= site.email %>" data-shuffle-load="single"
               class="font-mono text-base uppercase tracking-widest text-base-200 hover:text-accent transition-colors duration-300">Email</a>
            <a href="<%= site.github %>" target="_blank" rel="noopener noreferrer" data-shuffle-load="single"
               class="font-mono text-base uppercase tracking-widest text-base-200 hover:text-accent transition-colors duration-300">GitHub</a>
            <a href="<%= site.linkedin %>" target="_blank" rel="noopener noreferrer" data-shuffle-load="single"
               class="font-mono text-base uppercase tracking-widest text-base-200 hover:text-accent transition-colors duration-300">LinkedIn</a>
          </div>
          <a href="/resume/jay-kang-resume.pdf" download data-magnetic
             class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-accent text-white text-xs font-mono uppercase tracking-widest hover:bg-accent-hover transition-all duration-300">
            <span data-shuffle-load="single">Resume</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 11l5 5 5-5M12 16V4" />
            </svg>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══ FEATURED PROJECTS ═══ -->
  <section class="pt-4 pb-6 md:pt-6 md:pb-8">
    <div class="project-grid px-12 md:px-20 lg:px-36 grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5 lg:gap-6">
      <% featured.forEach((project, i) => { %>
        <%- include('../partials/project-card', { project, index: i }) %>
      <% }) %>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
<%- include('../partials/end') %>
