<!-- ═══ PROJECT CARD (used in carousel & elsewhere) ═══ -->
<%
  // Expects: project (object), index (number)
  const num = String(index + 1).padStart(2, '0');
%>
<a href="/projects/<%= project.slug %>" class="project-card w-[320px] md:w-[400px] aspect-[4/5] block">
  <img src="<%= project.thumbnail %>"
       alt="<%= project.title %> — <%= project.category %>"
       class="w-full h-full object-cover" loading="lazy" />
  <div class="card-overlay">
    <span class="card-num font-mono text-xs mb-1"><%= num %></span>
    <h3 class="card-title font-display text-xl font-bold tracking-tight"><%= project.title %></h3>
    <p class="card-cta font-mono text-xs uppercase tracking-widest mt-2 flex items-center gap-1">
      [ View project ]
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </p>
  </div>
</a>
